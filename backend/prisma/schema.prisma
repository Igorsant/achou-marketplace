generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  COMPRADOR
  LOJISTA
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  DECLINED
  REFUNDED
}

// ---------------------------------------------------------------- contas

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(COMPRADOR)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  seller Seller?
  cart   Cart?
  orders Order[]

  @@map("users")
}

model Seller {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  storeName String   @map("store_name")
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orderItems OrderItem[]

  @@map("sellers")
}

// ---------------------------------------------------------------- catalogo

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  sellerId    String        @map("seller_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  title       String
  description String?
  priceCents  Int           @map("price_cents")
  stock       Int           @default(0)
  salesCount  Int           @default(0) @map("sales_count")
  imageUrl    String?       @map("image_url")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Coluna GERADA pelo Postgres (GENERATED ALWAYS AS ... STORED).
  // O Prisma nao sabe emitir nem consultar tsvector: a busca usa $queryRaw.
  // Declarada aqui apenas para o migrate nao detectar drift.
  searchVector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  seller     Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([categoryId, priceCents])
  // Declarado aqui so para o migrate nao tentar dropar o indice GIN criado a mao.
  @@index([searchVector(ops: raw("tsvector_ops"))], map: "idx_products_search", type: Gin)
  @@map("products")
}

// ---------------------------------------------------------------- carrinho

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

// Sem preco: o carrinho nao congela valor nem reserva estoque.
model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------------------------------------------------------------- pedidos

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  buyerId        String      @map("buyer_id") @db.Uuid
  status         OrderStatus @default(PENDING_PAYMENT)
  totalCents     Int         @map("total_cents")
  idempotencyKey String      @unique @map("idempotency_key")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer   User        @relation(fields: [buyerId], references: [id])
  items   OrderItem[]
  payment Payment?

  @@index([buyerId, createdAt(sort: Desc)])
  @@map("orders")
}

// unitPriceCents e titleSnapshot sao copias do momento da compra:
// reajuste de preco pelo lojista nao pode reescrever pedido passado.
model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  productId      String @map("product_id") @db.Uuid
  sellerId       String @map("seller_id") @db.Uuid
  quantity       Int
  unitPriceCents Int    @map("unit_price_cents")
  titleSnapshot  String @map("title_snapshot")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  seller  Seller  @relation(fields: [sellerId], references: [id])

  @@index([sellerId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @unique @map("order_id") @db.Uuid
  status      PaymentStatus @default(PENDING)
  amountCents Int           @map("amount_cents")
  provider    String        @default("mock")
  providerRef String?       @map("provider_ref")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ---------------------------------------------------------------- outbox

model OutboxEvent {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

// Guarda o que ja foi consumido: o outbox entrega at-least-once,
// entao os workers precisam ser idempotentes.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("processed_events")
}
