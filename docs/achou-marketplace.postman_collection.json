              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "400 — validação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/seller/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "seller",
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ab\",\n  \"priceCents\": -5,\n  \"stock\": \"x\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('envelope com details', () => pm.expect(pm.response.json().error).to.have.property('details'));"
                ]
              }
            }
          ]
        },
        {
          "name": "401 — refresh token como access",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{refreshToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/seller/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "seller",
                "products"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Troque manualmente o header para `Bearer {{refreshToken}}`. A strategy rejeita `type: refresh`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('codigo TOKEN_INVALIDO', () =>",
                  "  pm.expect(pm.response.json().error.code).to.eql('TOKEN_INVALIDO'));"
                ]
              }
            }
          ]
        },
