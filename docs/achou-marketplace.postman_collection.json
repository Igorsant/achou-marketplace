    {
      "name": "Auth",
      "description": "Registro, login e renovacao de token.",
      "item": [
        {
          "name": "Register — LOJISTA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"loja.nova@achou.com\",\n  \"password\": \"senha12345\",\n  \"name\": \"Maria Silva\",\n  \"role\": \"LOJISTA\",\n  \"storeName\": \"Esportes Já!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "`storeName` so e exigido quando `role` = LOJISTA. O slug e derivado dele, sem acento."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 criado ou 409 ja existente', () =>",
                  "  pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', d.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', d.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
