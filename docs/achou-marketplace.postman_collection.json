    {
      "name": "Segurança (casos de erro)",
      "description": "Cenarios que devem falhar. Uteis para demonstrar as protecoes.",
      "item": [
        {
          "name": "401 — sem token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/seller/products",
